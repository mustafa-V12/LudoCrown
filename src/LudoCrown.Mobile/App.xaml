<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:LudoCrown.Mobile.Converters"
             x:Class="LudoCrown.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InvertBoolConverter x:Key="Invert" />
            <conv:PlayerColorConverter x:Key="PlayerColor" />
            <conv:AvatarImageConverter x:Key="AvatarImage" />
            <conv:NotNullConverter x:Key="NotNull" />
            <conv:EqualsToColorConverter x:Key="EqualsToColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
