<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Ludo Crown: "royal board-game night" — midnight velvet, gold, ivory and four jewel tones. -->
    <Color x:Key="Night">#140C2E</Color>
    <Color x:Key="Velvet">#21154A</Color>
    <Color x:Key="Plum">#2E1B5C</Color>
    <Color x:Key="PlumLight">#3D2875</Color>
    <Color x:Key="Gold">#E9B949</Color>
    <Color x:Key="GoldDeep">#B8862B</Color>
    <Color x:Key="Ivory">#FBF3E4</Color>
    <Color x:Key="Muted">#B9AED6</Color>
    <Color x:Key="Ink">#1A1230</Color>
    <Color x:Key="Danger">#FF6B6B</Color>
    <Color x:Key="Ruby">#D7263D</Color>
    <Color x:Key="Emerald">#17A673</Color>
    <Color x:Key="Topaz">#F2A71B</Color>
    <Color x:Key="Sapphire">#2F6FE0</Color>
    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A1660" Offset="0" />
        <GradientStop Color="#140C2E" Offset="0.55" />
        <GradientStop Color="#0E0822" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6D36B" Offset="0" />
        <GradientStop Color="#D9A23A" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
