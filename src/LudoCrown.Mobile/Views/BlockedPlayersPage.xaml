<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:api="clr-namespace:LudoCrown.App.Api;assembly=LudoCrown.App.Logic"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.BlockedPlayersPage"
                x:DataType="vm:BlockedPlayersViewModel">
    <Grid RowDefinitions="Auto,*">
        <views:PageHeader Title="Blocked players" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8" Spacing="10" MaximumWidthRequest="520">
                <Label Text="Blocked players can't join your tables, aren't matched with you, and their reactions are hidden." Style="{StaticResource Caption}" />
                <Label Text="You haven't blocked anyone." IsVisible="{Binding IsEmpty}" Style="{StaticResource Caption}" Margin="0,12" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Blocked}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="api:BlockedDto">
                            <Border Style="{StaticResource Card}" Padding="14,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding DisplayName}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Unblock" Style="{StaticResource LinkButton}"
                                            Command="{Binding UnblockCommand, Source={RelativeSource AncestorType={x:Type vm:BlockedPlayersViewModel}}, x:DataType=vm:BlockedPlayersViewModel}" CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
