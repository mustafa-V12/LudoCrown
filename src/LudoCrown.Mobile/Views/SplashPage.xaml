<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                x:Class="LudoCrown.Mobile.Views.SplashPage">
    <Grid RowDefinitions="*,Auto,Auto,*" RowSpacing="18">
        <Image Grid.Row="1" Source="crown_logo.png" WidthRequest="150" HeightRequest="112" SemanticProperties.Description="Ludo Crown logo" />
        <VerticalStackLayout Grid.Row="2" Spacing="16">
            <Label Text="Ludo Crown" Style="{StaticResource Title}" FontSize="38" HorizontalOptions="Center" />
            <Label Text="A royal board-game night" Style="{StaticResource Caption}" HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="True" WidthRequest="32" HeightRequest="32" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </Grid>
</views:BasePage>
