<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.HomePage"
                x:DataType="vm:HomeViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="16" MaximumWidthRequest="520">

            <!-- Profile bar -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <controls:AvatarView AvatarId="{Binding AvatarId}" Size="52" VerticalOptions="Center">
                    <controls:AvatarView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProfileCommand}" />
                    </controls:AvatarView.GestureRecognizers>
                </controls:AvatarView>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="18" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding LevelText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" IsVisible="{Binding IsSignedIn}" Style="{StaticResource Card}" Padding="12,6" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse Fill="{StaticResource GoldBrush}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="{Binding CoinsText}" FontAttributes="Bold" VerticalOptions="Center" SemanticProperties.Description="Coins" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="3" IsVisible="{Binding IsSignedIn}" Style="{StaticResource Card}" Padding="12,6" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StoreCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="💎" FontSize="15" VerticalOptions="Center" />
                        <Label Text="{Binding GemsText}" FontAttributes="Bold" VerticalOptions="Center" SemanticProperties.Description="Gems" />
                    </HorizontalStackLayout>
                </Border>
                <Button Grid.Column="4" Text="⚙" FontSize="22" Command="{Binding SettingsCommand}" Style="{StaticResource LinkButton}"
                        WidthRequest="48" SemanticProperties.Description="Settings" />
            </Grid>

            <!-- Which backend is in use: offline, local development server, or live. -->
            <Border Padding="12,6" StrokeShape="RoundRectangle 12" StrokeThickness="1" HorizontalOptions="Center"
                    Stroke="{StaticResource PlumLight}" Background="{StaticResource Plum}">
                <Label Text="{Binding EnvironmentText}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsGuest}" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="You're playing as a guest. Link an account to keep your progress." Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Link" Command="{Binding ProfileCommand}" Style="{StaticResource LinkButton}" />
                </Grid>
            </Border>

            <!-- Hero -->
            <VerticalStackLayout Spacing="4" Margin="0,8">
                <Image Source="crown_logo.png" WidthRequest="110" HeightRequest="82" SemanticProperties.Description="Ludo Crown logo" />
                <Label Text="Ludo Crown" Style="{StaticResource Title}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Game mode: chosen before the match, fixed once it starts -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Game mode" Style="{StaticResource Heading}" />
                    <controls:ModeSelector Picker="{Binding Modes}" />
                    <Label Text="{Binding Modes.SelectedSummary}" FontAttributes="Bold" />
                    <Label Text="{Binding Modes.SelectedDescription}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Online play -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Play online" Style="{StaticResource Heading}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Ranked" Command="{Binding SelectQueueCommand}" CommandParameter="ranked" Style="{StaticResource SecondaryButton}"
                                BorderColor="{Binding IsRanked, Converter={StaticResource EqualsToColor}, ConverterParameter=True}" BorderWidth="2.5" />
                        <Button Grid.Column="1" Text="Casual" Command="{Binding SelectQueueCommand}" CommandParameter="casual" Style="{StaticResource SecondaryButton}"
                                BorderColor="{Binding IsCasual, Converter={StaticResource EqualsToColor}, ConverterParameter=True}" BorderWidth="2.5" />
                    </Grid>
                    <Label Text="{Binding QueueDescription}" Style="{StaticResource Caption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="2 players" Command="{Binding PlayOnlineCommand}" CommandParameter="2" />
                        <Button Grid.Column="1" Text="4 players" Command="{Binding PlayOnlineCommand}" CommandParameter="4" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Private table -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Private table" Style="{StaticResource Heading}" />
                    <Label Text="Play with friends using a table code." Style="{StaticResource Caption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Create table" Command="{Binding CreateTableCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" Text="Join with code" Command="{Binding JoinTableCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Offline -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Play offline" Style="{StaticResource Heading}" />
                    <Label Text="Challenge the computer or pass the phone around — no internet needed." Style="{StaticResource Caption}" />
                    <Label Text="You have an unfinished game." IsVisible="{Binding HasSavedGame}" TextColor="{StaticResource Gold}" FontSize="14" />
                    <Button Text="Play vs computer" Command="{Binding PlayOfflineCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="🏆 League" Command="{Binding LeagueCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="🛒 Store" Command="{Binding StoreCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Profile" Command="{Binding ProfileCommand}" Style="{StaticResource LinkButton}" />
                <Button Grid.Column="1" Text="Friends" Command="{Binding FriendsCommand}" Style="{StaticResource LinkButton}" />
                <Button Grid.Column="2" Text="How to play" Command="{Binding RulesCommand}" Style="{StaticResource LinkButton}" />
            </Grid>

            <Button Text="Sign in to play online" IsVisible="{Binding IsSignedOut}" Command="{Binding SignInCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
