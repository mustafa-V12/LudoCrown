<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:proto="clr-namespace:LudoCrown.Core.Protocol;assembly=LudoCrown.Core"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.PrivateRoomPage"
                x:DataType="vm:PrivateRoomViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <views:PageHeader x:Name="Header" Title="Private table" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8" Spacing="16" MaximumWidthRequest="480">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Table code" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Text="{Binding Code}" FontSize="44" FontAttributes="Bold" CharacterSpacing="6" TextColor="{StaticResource Gold}"
                               HorizontalOptions="Center" SemanticProperties.Description="Table code" />
                        <Button Text="Share invite" Command="{Binding ShareCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding SeatsText}" Style="{StaticResource Heading}" />
                <CollectionView ItemsSource="{Binding Seats}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="proto:SeatInfo">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4,8">
                                <controls:AvatarView AvatarId="{Binding AvatarId}" RingColor="{Binding Color, Converter={StaticResource PlayerColor}}" Size="46" />
                                <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="18" VerticalOptions="Center" />
                                <BoxView Grid.Column="2" Color="{Binding Color, Converter={StaticResource PlayerColor}}" WidthRequest="16" HeightRequest="16" CornerRadius="8" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding HintText}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                <Button Text="Try again" IsVisible="{Binding HasError}" Command="{Binding RetryCommand}" Style="{StaticResource LinkButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Padding="24,8,24,20" Spacing="10">
            <Button Text="Start game" Command="{Binding StartCommand}" IsVisible="{Binding IsHost}" />
            <Button Text="Leave table" Command="{Binding LeaveCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </Grid>
</views:BasePage>
