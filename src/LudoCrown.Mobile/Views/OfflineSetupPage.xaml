<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.OfflineSetupPage"
                x:DataType="vm:OfflineSetupViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <views:PageHeader Title="Play offline" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8" Spacing="14" MaximumWidthRequest="520">
                <Image Source="tile_offline.png" HeightRequest="96" SemanticProperties.Description="Play against the computer" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasSave}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="You have an unfinished game." VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Resume" Command="{Binding ResumeCommand}" />
                    </Grid>
                </Border>

                <Label Text="Game mode" Style="{StaticResource Heading}" />
                <controls:ModeSelector Picker="{Binding Modes}" />
                <Label Text="{Binding Modes.SelectedSummary}" FontAttributes="Bold" />
                <Label Text="Gem rerolls and Shield bottles are online-only, because gems are kept on the server." Style="{StaticResource Caption}" />

                <Label Text="Players" Style="{StaticResource Heading}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="2 players" Command="{Binding SetPlayersCommand}" CommandParameter="2" Style="{StaticResource SecondaryButton}"
                            BorderColor="{Binding PlayerCount, Converter={StaticResource EqualsToColor}, ConverterParameter=2}" BorderWidth="2.5" />
                    <Button Grid.Column="1" Text="4 players" Command="{Binding SetPlayersCommand}" CommandParameter="4" Style="{StaticResource SecondaryButton}"
                            BorderColor="{Binding PlayerCount, Converter={StaticResource EqualsToColor}, ConverterParameter=4}" BorderWidth="2.5" />
                </Grid>

                <Label Text="Seats" Style="{StaticResource Heading}" />
                <Label Text="Switch a seat to a person for pass-and-play on this phone." Style="{StaticResource Caption}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Seats}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OfflineSeatOption">
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <BoxView Color="{Binding ColorName, Converter={StaticResource PlayerColor}}" WidthRequest="22" HeightRequest="22" CornerRadius="11" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Name}" MaxLength="16" Placeholder="Name" FontSize="16" />
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6" IsVisible="{Binding CanChangeKind}" VerticalOptions="Center">
                                        <Label Text="Bot" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        <Switch IsToggled="{Binding IsBot}" SemanticProperties.Description="Computer player" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="2" Text="You" IsVisible="{Binding CanChangeKind, Converter={StaticResource Invert}}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    <Picker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Title="Difficulty" IsVisible="{Binding IsBot}"
                                            ItemsSource="{Binding Difficulties}"
                                            SelectedIndex="{Binding DifficultyIndex}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="PLAY" FontSize="22" MinimumHeightRequest="58" Command="{Binding StartCommand}" Margin="20,8,20,20" />
    </Grid>
</views:BasePage>
