<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.SignInPage"
                x:DataType="vm:SignInViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="28,40" Spacing="14" MaximumWidthRequest="480">
            <Image Source="crown_logo.png" WidthRequest="120" HeightRequest="90" SemanticProperties.Description="Ludo Crown logo" />
            <Label Text="Ludo Crown" Style="{StaticResource Title}" HorizontalOptions="Center" />
            <Label Text="Sign in to play online with friends and keep your progress." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,0,0,12" />

            <!-- Apple's button guidelines: black or white, prominent. -->
            <Button Text="Sign in with Apple" IsVisible="{Binding ShowApple}" Command="{Binding AppleCommand}"
                    Background="White" TextColor="Black" SemanticProperties.Description="Sign in with Apple" />
            <Button Text="Continue with Google" IsVisible="{Binding ShowGoogle}" Command="{Binding GoogleCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Continue with Facebook" IsVisible="{Binding ShowFacebook}" Command="{Binding FacebookCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Continue with email" IsVisible="{Binding ShowEmail}" Command="{Binding EmailCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Play as guest" IsVisible="{Binding ShowGuest}" Command="{Binding GuestCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasServerNotice}" Margin="0,8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ServerNotice}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    <Button Text="Try again" Command="{Binding RetryCommand}" Style="{StaticResource LinkButton}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Play offline against the computer" Command="{Binding OfflineCommand}" Style="{StaticResource LinkButton}" Margin="0,10,0,0" />
            <Label Text="Guest progress is saved to this device's account. Link Apple, Google, Facebook or email later in your profile to keep it."
                   Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
