<?xml version="1.0" encoding="utf-8" ?>
<!-- Game screen in the classic mobile-Ludo layout: the board in the middle, a player (avatar, name, die) in each corner. -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.GamePage"
                x:DataType="vm:GameViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10,4,10,8" RowSpacing="4">

        <!-- Top bar: leave, rules, mode, gems -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <ImageButton Source="icon_menu.png" Style="{StaticResource IconButton}" Command="{Binding LeaveCommand}" SemanticProperties.Description="Leave game" />
            <Border Grid.Column="1" Style="{StaticResource Pill}" HeightRequest="40" Padding="10,0" SemanticProperties.Description="Rules for this mode">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding RulesInfoCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="5">
                    <Image Source="icon_info.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label Text="Rules" Style="{StaticResource PillText}" FontSize="15" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Pill}" HeightRequest="40" Padding="10,0" Stroke="{StaticResource Gold}" StrokeThickness="2">
                <HorizontalStackLayout Spacing="5">
                    <Image Source="icon_crown.png" WidthRequest="24" HeightRequest="20" VerticalOptions="Center" />
                    <Label Text="{Binding ModeChip}" Style="{StaticResource PillText}" FontSize="14" TextColor="{StaticResource GoldLight}"
                           SemanticProperties.Description="{Binding ModeText}" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Pill}" IsVisible="{Binding ShowRerollBar}" HeightRequest="40">
                <HorizontalStackLayout Spacing="4">
                    <Image Source="icon_gem.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                    <Label Text="{Binding GemsText}" Style="{StaticResource PillText}" SemanticProperties.Description="Gem balance" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Status -->
        <Label Grid.Row="1" x:Name="StatusLabel" Text="{Binding Status}" FontFamily="BalooBold" FontSize="15"
               HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{StaticResource Muted}" />

        <!-- Table: top corners, board, bottom corners -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <ContentView x:Name="SeatTopLeft" />
                <ContentView Grid.Column="1" x:Name="SeatTopRight" />
            </Grid>
            <controls:BoardView Grid.Row="1" x:Name="Board" HorizontalOptions="Fill" VerticalOptions="Fill" />
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                <ContentView x:Name="SeatBottomLeft" />
                <ContentView Grid.Column="1" x:Name="SeatBottomRight" />
            </Grid>

            <!-- Notice toast -->
            <Border Grid.Row="1" IsVisible="{Binding HasNotice}" Padding="18,6" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Gold}" StrokeThickness="2"
                    VerticalOptions="Center" HorizontalOptions="Center" Background="#F23D2875" InputTransparent="True" Margin="24,0">
                <Border.Shadow><Shadow Brush="Black" Offset="0,8" Radius="18" Opacity="0.5" /></Border.Shadow>
                <Label Text="{Binding Notice}" HorizontalTextAlignment="Center" FontFamily="BalooHeavy" FontSize="15" />
            </Border>
        </Grid>

        <!-- Action bar: gem reroll, pass, Shield, chat (online). State and reasons come from the server snapshot. -->
        <VerticalStackLayout Grid.Row="3" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsOnline}">
                <!-- Reroll: round button with its gem cost, as in classic Ludo apps -->
                <Grid IsVisible="{Binding ShowRerollBar}" SemanticProperties.Description="{Binding RerollButtonText}" SemanticProperties.Hint="{Binding RerollHint}">
                    <Button Command="{Binding RerollCommand}" IsEnabled="{Binding CanReroll}" WidthRequest="58" HeightRequest="58" CornerRadius="29" Padding="0"
                            Style="{StaticResource SecondaryButton}" ImageSource="icon_reroll.png" />
                    <Border HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,-10" Padding="6,0" StrokeShape="RoundRectangle 9" Background="{StaticResource Ink}"
                            Stroke="{StaticResource Gold}" StrokeThickness="1.5" InputTransparent="True">
                        <HorizontalStackLayout Spacing="2">
                            <Label Text="1" FontFamily="BalooHeavy" FontSize="12" VerticalOptions="Center" />
                            <Image Source="icon_gem.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="-4" IsVisible="{Binding ShowRerollBar}">
                    <Label Text="{Binding RerollCountText}" FontFamily="BalooHeavy" FontSize="15" />
                    <Label Text="{Binding RerollHint}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Pass" Command="{Binding PassCommand}" IsVisible="{Binding CanPass}" Style="{StaticResource SecondaryButton}" Padding="14,6" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                    <Button Text="{Binding BoostButtonText}" Command="{Binding BoostCommand}" IsVisible="{Binding ShowBoost}" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" FontSize="14" ImageSource="icon_shield.png" ContentLayout="Left,4" SemanticProperties.Hint="{Binding BoostHint}" />
                    <Button Text="CHAT" Command="{Binding ToggleChatCommand}" IsVisible="{Binding ShowReactions}" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" FontSize="14" ImageSource="icon_chat.png" ContentLayout="Left,4" SemanticProperties.Description="Open quick chat" />
                </HorizontalStackLayout>
            </Grid>
            <Label Text="Ranked match: boosts are off" IsVisible="{Binding BoostsOffNotice}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
            <Label Text="{Binding OfflineNote}" IsVisible="{Binding ShowOfflineNote}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Quick chat panel: preset phrases and emoji only (no free text). Tap a player's avatar to mute them. -->
        <Grid Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsChatOpen}" VerticalOptions="End" Margin="0,0,0,4">
            <Border Style="{StaticResource Panel}" Padding="12,30,12,12" Margin="0,18,0,0">
                <VerticalStackLayout Spacing="8">
                    <FlexLayout x:Name="PhraseGrid" Wrap="Wrap" JustifyContent="SpaceBetween" />
                    <FlexLayout x:Name="EmojiRow" Wrap="Wrap" JustifyContent="SpaceAround" />
                    <Label Text="Tap a player's avatar to mute them. You can turn chat off in Settings." Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Ribbon}">
                <Label Text="Quick chat" Style="{StaticResource RibbonText}" FontSize="17" />
            </Border>
            <ImageButton Source="icon_close.png" HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,-6,0" WidthRequest="40" HeightRequest="40" Padding="8"
                         CornerRadius="12" BorderColor="White" BorderWidth="3" Background="{StaticResource RedBrush}" Command="{Binding ToggleChatCommand}"
                         SemanticProperties.Description="Close chat" />
        </Grid>
    </Grid>
</views:BasePage>
