<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.LeaguePage"
                x:DataType="vm:LeagueViewModel">
    <Grid RowDefinitions="Auto,*">
        <views:PageHeader Title="League" />
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <ScrollView>
                <VerticalStackLayout Padding="20,8,20,28" Spacing="14" MaximumWidthRequest="560">
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasEnvironmentNotice}" Stroke="{StaticResource Topaz}" StrokeThickness="2">
                        <Label Text="{Binding EnvironmentNotice}" FontAttributes="Bold" TextColor="{StaticResource Topaz}" />
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding SeasonTitle}" Style="{StaticResource Heading}" />
                                <Label Grid.Column="1" Text="{Binding DivisionText}" TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding SeasonClock}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding StandingText}" FontAttributes="Bold" />
                            <Label Text="{Binding ZoneText}" TextColor="{StaticResource Gold}" />
                            <Label Text="{Binding LastSeasonText}" IsVisible="{Binding HasLastSeason}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Your group" Style="{StaticResource Heading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Group}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeagueRowView">
                                <Border Style="{StaticResource Card}" Padding="12,8"
                                        Stroke="{Binding IsYou, Converter={StaticResource EqualsToColor}, ConverterParameter=True}">
                                    <Grid ColumnDefinitions="36,Auto,*,Auto,24" ColumnSpacing="10">
                                        <Label Text="{Binding Rank}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                                        <controls:AvatarView Grid.Column="1" AvatarId="{Binding AvatarId}" Size="36" />
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="3" Text="{Binding Points}" FontAttributes="Bold" TextColor="{StaticResource Gold}" VerticalOptions="Center" />
                                        <Label Grid.Column="4" Text="{Binding Zone}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPlayerCommand, Source={RelativeSource AncestorType={x:Type vm:LeagueViewModel}}, x:DataType=vm:LeagueViewModel}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Season rewards" Style="{StaticResource Heading}" />
                    <Border Style="{StaticResource Card}" Padding="10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="1.1*,*,*,*" ColumnSpacing="6">
                                <Label Text="Division" Style="{StaticResource Caption}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding BandHeader1}" Style="{StaticResource Caption}" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="{Binding BandHeader2}" Style="{StaticResource Caption}" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="{Binding BandHeader3}" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rewards}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RewardRowView">
                                        <Grid ColumnDefinitions="1.1*,*,*,*" ColumnSpacing="6">
                                            <Label Text="{Binding Division}" FontAttributes="Bold" FontSize="13" />
                                            <Label Grid.Column="1" Text="{Binding Band1}" FontSize="12" />
                                            <Label Grid.Column="2" Text="{Binding Band2}" FontSize="12" />
                                            <Label Grid.Column="3" Text="{Binding Band3}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Rules" Style="{StaticResource Heading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</views:BasePage>
