<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.PlayerProfilePage"
                x:DataType="vm:PlayerProfileViewModel">
    <Grid RowDefinitions="Auto,*">
        <views:PageHeader Title="Player" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,28" Spacing="14" MaximumWidthRequest="520">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Gold}" />
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <controls:AvatarView AvatarId="{Binding AvatarId}" Size="96" HorizontalOptions="Center" />
                    <Label Text="{Binding DisplayName}" Style="{StaticResource Title}" HorizontalOptions="Center" />
                    <Label Text="{Binding LevelText}" TextColor="{StaticResource Gold}" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{Binding PublicId, StringFormat='Player code {0}'}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="League" Style="{StaticResource Heading}" />
                        <Label Text="{Binding LeagueText}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Statistics" Style="{StaticResource Heading}" />
                <Label Text="This player keeps their statistics private." IsVisible="{Binding StatsHidden}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Card}" Padding="10" IsVisible="{Binding StatsHidden, Converter={StaticResource Invert}}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="1.2*,*,*,*,1.6*" ColumnSpacing="6">
                            <Label Text="Mode" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Played" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="Won" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="Win %" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="Win streak" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stats}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatRow">
                                    <Grid ColumnDefinitions="1.2*,*,*,*,1.6*" ColumnSpacing="6">
                                        <Label Text="{Binding Label}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding Played}" />
                                        <Label Grid.Column="2" Text="{Binding Won}" />
                                        <Label Grid.Column="3" Text="{Binding WinRate}" />
                                        <Label Grid.Column="4" Text="{Binding Streak}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanInteract}">
                    <Button Text="Add friend" IsVisible="{Binding CanAddFriend}" Command="{Binding AddFriendCommand}" />
                    <Button Text="Block" Command="{Binding BlockCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Text="Report" Command="{Binding ReportCommand}" Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
