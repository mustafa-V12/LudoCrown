<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:LudoCrown.Mobile.Views"
                xmlns:controls="clr-namespace:LudoCrown.Mobile.Controls"
                xmlns:vm="clr-namespace:LudoCrown.App.ViewModels;assembly=LudoCrown.App.Logic"
                x:Class="LudoCrown.Mobile.Views.ResultsPage"
                x:DataType="vm:ResultsViewModel">
    <Grid>
        <ScrollView>
            <Grid Padding="16,40,16,20" MaximumWidthRequest="460" VerticalOptions="Center">
                <Border Style="{StaticResource Panel}" Margin="0,22,0,0">
                    <VerticalStackLayout Spacing="10">
                        <Image x:Name="Crown" Source="crown_logo.png" WidthRequest="120" HeightRequest="90" SemanticProperties.Description="Crown" />
                        <Label Text="{Binding Title}" Style="{StaticResource Title}" FontSize="32" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        <Border IsVisible="{Binding HasRewards}" HorizontalOptions="Center" Padding="16,4" StrokeShape="RoundRectangle 16"
                                Background="#B30A051C" Stroke="{StaticResource Gold}" StrokeThickness="2">
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="icon_coin.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                <Label Text="{Binding RewardsText}" FontFamily="BalooHeavy" TextColor="{StaticResource GoldLight}" FontSize="17" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label Text="{Binding LeagueText}" IsVisible="{Binding HasLeague}" FontFamily="BalooHeavy" HorizontalOptions="Center" />
                        <Label Text="{Binding ModeText}" Style="{StaticResource Caption}" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="6" Margin="0,4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResultRow">
                                    <Border Padding="10,6" StrokeShape="RoundRectangle 16" Background="#800A051C" Stroke="#1FFFFFFF" StrokeThickness="2">
                                        <Grid ColumnDefinitions="46,Auto,*" ColumnSpacing="10">
                                            <Label Text="{Binding PlacementText}" FontFamily="BalooHeavy" FontSize="19" TextColor="{StaticResource GoldLight}" VerticalOptions="Center" />
                                            <Grid Grid.Column="1" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                                <BoxView Color="White" CornerRadius="12" />
                                                <BoxView Color="{Binding Color, Converter={StaticResource PlayerColor}}" CornerRadius="10" Margin="2" />
                                            </Grid>
                                            <Label Grid.Column="2" Text="{Binding Name}" FontFamily="BalooHeavy" FontSize="17" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                        <Grid ColumnDefinitions="*,1.3*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Text="LOBBY" Command="{Binding HomeCommand}" Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="1" Text="{Binding PlayAgainText}" Command="{Binding PlayAgainCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Ribbon}">
                    <Label x:Name="RibbonLabel" Text="Game over" Style="{StaticResource RibbonText}" />
                </Border>
            </Grid>
        </ScrollView>
        <controls:ConfettiView x:Name="Confetti" />
    </Grid>
</views:BasePage>
