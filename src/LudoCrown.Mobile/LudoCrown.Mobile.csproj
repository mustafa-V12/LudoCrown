<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Ludo Crown — .NET MAUI app (iOS is the release target; Android and Windows are included so the app can be
    run and tested from Visual Studio on Windows without a Mac).

    Requires: .NET 10 SDK + the MAUI workload ("dotnet workload install maui", or the ".NET Multi-platform App UI
    development" workload in the Visual Studio Installer). iOS builds additionally need a paired Mac with Xcode
    (Visual Studio "Pair to Mac") or a cloud macOS build. See README.md.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Build only the Windows app (no iOS/Android workloads needed): dotnet build -p:LudoWindowsOnly=true -f net10.0-windows10.0.19041.0 -->
    <TargetFrameworks Condition="'$(LudoWindowsOnly)' == 'true'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Windows dev builds run unpackaged, so bin\...\LudoCrown.Mobile.exe starts directly (no MSIX deployment). -->
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
    <OutputType>Exe</OutputType>
    <RootNamespace>LudoCrown.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>Ludo Crown</ApplicationTitle>
    <!-- TODO before release: replace with YOUR reverse-domain bundle identifier registered in your Apple Developer account. -->
    <ApplicationId>com.example.ludocrown</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Set to true once the "Sign in with Apple" capability is enabled for your App ID (see docs/AUTH_SETUP.md). -->
    <EnableAppleSignIn Condition="'$(EnableAppleSignIn)' == ''">false</EnableAppleSignIn>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <CodesignEntitlements Condition="'$(EnableAppleSignIn)' == 'true'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(EnableAppleSignIn)' != 'true'">Platforms\iOS\Entitlements.Basic.plist</CodesignEntitlements>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
    <!-- App Store signing. Fill in after creating certificates/profiles in your Apple Developer account. -->
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>Apple Distribution</CodesignKey>
    <CodesignProvision></CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#140C2E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#140C2E" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*.svg" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <!-- Apple privacy manifest (required for App Store submissions). -->
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LudoCrown.Core\LudoCrown.Core.csproj" />
    <ProjectReference Include="..\LudoCrown.App.Logic\LudoCrown.App.Logic.csproj" />
  </ItemGroup>
</Project>
