{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "ludocrown",
    "Audience": "ludocrown-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60
  },
  "Auth": {
    "PublicBaseUrl": "https://YOUR-SERVER-HOST",
    "AppCallbackScheme": "ludocrown",
    "GuestEnabled": true,
    "Apple": {
      "ClientIds": [],
      "TeamId": "",
      "KeyId": "",
      "PrivateKey": ""
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "FacebookGraphVersion": "v21.0",
    "Email": {
      "Enabled": false,
      "Sender": "Smtp",
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpUser": "",
      "SmtpPassword": "",
      "FromAddress": ""
    }
  },
  "Match": {
    "TurnSeconds": 20,
    "DisconnectedTurnSeconds": 6,
    "DisconnectGraceSeconds": 90,
    "MaxMissedTurns": 3,
    "BotDelaySeconds": 1.0,
    "MatchmakingBotFillSeconds": 30,
    "ChatEnabled": true
  },
  "Database": {
    "MigrateOnStartup": false,
    "MatchRetentionDays": 730
  },
  "DevTools": {
    "AllowGemGrant": false
  },
  "Store": {
    "ProductIdPrefix": "PLACEHOLDER.BUNDLE.ID",
    "DevSandbox": false,
    "Apple": {
      "BundleId": "",
      "IssuerId": "",
      "KeyId": "",
      "PrivateKeyPath": "",
      "RootCertificatePaths": [],
      "Environment": "Production",
      "AllowSandboxFallback": true,
      "RequireAppAccountToken": true
    }
  },
  "League": {
    "Enabled": true,
    "SeasonDays": 14
  }
}