{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "PublicBaseUrl": "http://localhost:5080",
    "Email": {
      "Enabled": true,
      "Sender": "Log"
    }
  },
  "Match": {
    "MatchmakingBotFillSeconds": 10
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "DevTools": {
    "AllowGemGrant": true
  },
  "Store": {
    "DevSandbox": true
  },
  "League": {
    "SeasonDays": 7
  }
}