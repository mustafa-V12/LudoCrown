<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DEVELOPMENT TOOL ONLY. Runs the xUnit test sources without NuGet access by compiling them against a
    tiny xUnit-compatible shim (Fact/Theory/InlineData/MemberData/Assert) and a reflection runner.
    It exists because the build environment used to create this project could not reach nuget.org.
    In Visual Studio, use the real test projects in /tests (Test Explorer) instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CS8618;xUnit1026</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\tests\LudoCrown.Core.Tests\**\*.cs" Exclude="..\..\tests\LudoCrown.Core.Tests\obj\**;..\..\tests\LudoCrown.Core.Tests\bin\**" LinkBase="Core.Tests" />
    <Compile Include="..\..\tests\LudoCrown.Server.Tests\**\*.cs" Exclude="..\..\tests\LudoCrown.Server.Tests\obj\**;..\..\tests\LudoCrown.Server.Tests\bin\**" LinkBase="Server.Tests" />
    <Compile Include="..\..\tests\LudoCrown.App.Tests\**\*.cs" Exclude="..\..\tests\LudoCrown.App.Tests\obj\**;..\..\tests\LudoCrown.App.Tests\bin\**" LinkBase="App.Tests" />
  </ItemGroup>
  <!-- With -p:NpgsqlStub=true also compile the PostgreSQL integration tests (against the psql-backed stub). -->
  <ItemGroup Condition="'$(NpgsqlStub)' == 'true'">
    <Compile Include="..\..\tests\LudoCrown.Postgres.Tests\**\*.cs" Exclude="..\..\tests\LudoCrown.Postgres.Tests\obj\**;..\..\tests\LudoCrown.Postgres.Tests\bin\**" LinkBase="Postgres.Tests" />
    <ProjectReference Include="..\..\src\LudoCrown.Server.Postgres\LudoCrown.Server.Postgres.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\LudoCrown.Core\LudoCrown.Core.csproj" />
    <ProjectReference Include="..\..\src\LudoCrown.Server\LudoCrown.Server.csproj" />
    <ProjectReference Include="..\..\src\LudoCrown.App.Logic\LudoCrown.App.Logic.csproj" />
  </ItemGroup>
</Project>
