# Copy to deploy/.env for local development. NEVER commit real values. Production secrets belong in your
# hosting provider's secret store (Azure Key Vault / App Settings, Fly secrets, AWS Secrets Manager, ...).

POSTGRES_USER=ludocrown
POSTGRES_PASSWORD=change-me-local-only

# 32+ random bytes, base64. Generate with:  openssl rand -base64 32
#   (PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]]))
JWT_SIGNING_KEY=REPLACE_WITH_BASE64_32_BYTES

# ---- Production-only settings (set as environment variables on the server) ----
# ConnectionStrings__Postgres=Host=...;Database=ludocrown;Username=ludocrown_app;Password=...;SSL Mode=Require
# Jwt__SigningKey=...
# Auth__PublicBaseUrl=https://api.your-domain.com
# Auth__Apple__ClientIds__0=com.yourcompany.ludocrown
# Auth__Apple__TeamId=XXXXXXXXXX
# Auth__Apple__KeyId=XXXXXXXXXX
# Auth__Apple__PrivateKey=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Auth__Google__ClientId=....apps.googleusercontent.com
# Auth__Google__ClientSecret=...
# Auth__Facebook__ClientId=...
# Auth__Facebook__ClientSecret=...
# Auth__Email__Enabled=true
# Auth__Email__Sender=Smtp
# Auth__Email__SmtpHost=smtp.your-provider.com
# Auth__Email__SmtpUser=...
# Auth__Email__SmtpPassword=...
# Auth__Email__FromAddress=no-reply@your-domain.com

# ---- In-app purchases (App Store Server API) — see docs/STORE.md ----
# Store__ProductIdPrefix=com.yourcompany.ludocrown
# Store__Apple__BundleId=com.yourcompany.ludocrown
# Store__Apple__IssuerId=00000000-0000-0000-0000-000000000000
# Store__Apple__KeyId=XXXXXXXXXX
# Store__Apple__PrivateKeyPem=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Store__Apple__RootCertificatePaths__0=/app/certs/AppleRootCA-G3.cer
# Store__Apple__Environment=Production
# Never set Store__DevSandbox or DevTools__AllowGemGrant in production (they are ignored outside Development anyway).

# ---- League ----
# League__Enabled=true
# League__SeasonDays=14
